# birth-date-local.properties로 복사해서 실제 값을 채우세요. birth-date-local.properties는 git에 커밋되지 않습니다.
# 기업·국민은행 등록 시 받은 birthDate를 저장 암호화(AES-256-GCM)하는 키. 32바이트를 Base64로 인코딩한 값.
# 생성 예: openssl rand -base64 32
# 값이 없거나 32바이트(Base64 디코딩 기준)가 아니면 애플리케이션 시작 시 실패합니다.
birth-date.encryption.key-base64=
# 키 회전 시 버전을 올리세요. 기존에 저장된 값은 저장 당시의 버전으로 복호화해야 합니다.
birth-date.encryption.key-version=1
