<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ntropy.user.mapper.UserMapper">

    <resultMap id="userResultMap" type="com.ntropy.user.domain.entity.User">
        <id property="userId" column="user_id"/>
        <result property="email" column="email"/>
        <result property="name" column="name"/>
        <result property="providerId" column="provider_id"/>
        <result property="refreshTokenHash" column="refresh_token_hash"/>
        <result property="alarmAgree" column="alarm_agree"/>
        <result property="locationAgree" column="location_agree"/>
        <result property="refreshTokenExpireAt" column="refresh_token_expire_at"/>
        <result property="provider" column="provider"/>
        <result property="status" column="status"/>
        <result property="role" column="role"/>
        <result property="createdAt" column="created_at"/>
        <result property="lastLoginAt" column="last_login_at"/>
        <result property="onboardingCompleted" column="onboarding_completed"/>
        <result property="termsAgreed" column="terms_agreed"/>
    </resultMap>

    <!-- 유저 조회 -->
    <select id="findByProviderAndProviderId" resultMap="userResultMap">
        SELECT *
        FROM USERS
        WHERE provider = #{provider}
          AND provider_id = #{providerId}
    </select>

    <!-- 신규 회원 DB에 저장. (provider, provider_id) unique key 경합 시 새 행을 만들지 않고
         LAST_INSERT_ID(user_id) 트릭으로 기존 행의 user_id를 반환한다. 그 외 컬럼은 갱신하지 않으므로
         호출자는 이 insert 이후 항상 findByProviderAndProviderId로 재조회해 저장된 값을 신뢰해야 한다. -->
    <insert id="insertUser" parameterType="com.ntropy.user.domain.entity.User" useGeneratedKeys="true" keyProperty="userId">
        INSERT INTO USERS (
            email, name, provider_id, refresh_token_hash,
            alarm_agree, location_agree, refresh_token_expire_at,
            provider, status, role, created_at,
            last_login_at, onboarding_completed, terms_agreed
        ) VALUES (
                     #{email}, #{name}, #{providerId}, #{refreshTokenHash},
                     IFNULL(#{alarmAgree}, false), IFNULL(#{locationAgree}, false), #{refreshTokenExpireAt},
                     #{provider}, #{status}, #{role}, NOW(),
                     #{lastLoginAt}, #{onboardingCompleted}, #{termsAgreed}
                 )
        ON DUPLICATE KEY UPDATE user_id = LAST_INSERT_ID(user_id)
    </insert>

    <!-- 고유 번호(userId)로 유저 조회  -->
    <select id="findById" resultMap="userResultMap">
        SELECT *
        FROM USERS
        WHERE user_id = #{userId}
    </select>

    <!-- 로그인 유지 정보 및 마지막 접속 시간 갱신 -->
    <update id="updateLoginInfo" parameterType="com.ntropy.user.domain.entity.User">
        UPDATE USERS
        SET last_login_at = NOW(),
            refresh_token_hash = #{refreshTokenHash},
            refresh_token_expire_at = #{refreshTokenExpireAt}
        WHERE user_id = #{userId}
    </update>

    <!-- 회원 정보 수정 -->
    <update id="updateUser" parameterType="com.ntropy.user.domain.entity.User">
        UPDATE USERS
        SET name = #{name},
            alarm_agree = #{alarmAgree},
            location_agree = #{locationAgree}
        WHERE user_id = #{userId}
    </update>

    <!-- 온보딩 완료 처리 -->
    <update id="updateOnboardingCompleted" parameterType="java.lang.Long">
        UPDATE USERS
        SET onboarding_completed = true
        WHERE user_id = #{userId}
    </update>

    <!-- 회원 탈퇴 -->
    <delete id="deleteUser" parameterType="java.lang.Long">
        DELETE FROM USERS WHERE user_id = #{userId}
    </delete>

    <!-- 로그아웃 시 Refresh Token 정보 폐기 -->
    <update id="invalidateRefreshToken" parameterType="java.lang.Long">
        UPDATE USERS
        SET refresh_token_hash = NULL,
            refresh_token_expire_at = NULL
        WHERE user_id = #{userId}
    </update>

    <select id="findByRefreshToken" parameterType="string" resultMap="userResultMap">
        SELECT *
        FROM USERS
        WHERE refresh_token_hash = #{refreshToken}
    </select>

    <!-- provider 기준 전체 회원 조회 (가상회원 시딩 목록 조회용) -->
    <select id="findAllByProvider" resultMap="userResultMap">
        SELECT *
        FROM USERS
        WHERE provider = #{provider}
        ORDER BY provider_id
    </select>

    <!-- 배치 대상 활성 사용자 ID 조회. scope=REAL_ONLY는 가상회원(virtualProvider)을 제외하고,
         VIRTUAL_ONLY는 가상회원만, ALL은 필터 없이 조회한다. -->
    <select id="findActiveUserIds"
            resultType="java.lang.Long">

        SELECT user_id
        FROM USERS
        WHERE status = 'ACTIVE'
        <if test="scope == 'REAL_ONLY'">
            AND (provider IS NULL OR provider != #{virtualProvider})
        </if>
        <if test="scope == 'VIRTUAL_ONLY'">
            AND provider = #{virtualProvider}
        </if>
        ORDER BY user_id

    </select>

</mapper>
