<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ntropy.work.mapper.JobScheduleMapper">

    <resultMap id="jobScheduleResultMap" type="com.ntropy.work.domain.entity.JobSchedule">
        <id property="scheduleId" column="schedule_id"/>
        <result property="jobId" column="job_id"/>
        <result property="dayOfWeek" column="day_of_week"/>
        <result property="startTime" column="start_time"/>
        <result property="endTime" column="end_time"/>
    </resultMap>

    <insert id="insert" parameterType="com.ntropy.work.domain.entity.JobSchedule"
            useGeneratedKeys="true" keyProperty="scheduleId">
        INSERT INTO JOB_SCHEDULE (job_id, day_of_week, start_time, end_time)
        VALUES (#{jobId}, #{dayOfWeek}, #{startTime}, #{endTime})
    </insert>

    <select id="findById" parameterType="long" resultMap="jobScheduleResultMap">
        SELECT schedule_id, job_id, day_of_week, start_time, end_time
        FROM JOB_SCHEDULE
        WHERE schedule_id = #{scheduleId}
    </select>

    <select id="findByJobId" parameterType="long" resultMap="jobScheduleResultMap">
        SELECT schedule_id, job_id, day_of_week, start_time, end_time
        FROM JOB_SCHEDULE
        WHERE job_id = #{jobId}
    </select>

    <update id="update" parameterType="com.ntropy.work.domain.entity.JobSchedule">
        UPDATE JOB_SCHEDULE
        SET day_of_week = #{dayOfWeek},
            start_time = #{startTime},
            end_time = #{endTime}
        WHERE schedule_id = #{scheduleId}
    </update>

    <delete id="deleteById" parameterType="long">
        DELETE FROM JOB_SCHEDULE
        WHERE schedule_id = #{scheduleId}
    </delete>

    <delete id="deleteByJobId" parameterType="long">
        DELETE FROM JOB_SCHEDULE
        WHERE job_id = #{jobId}
    </delete>

</mapper>
