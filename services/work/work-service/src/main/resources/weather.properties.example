# weather-local.properties로 복사해서 쓰세요 (weather-local.properties는 git에 커밋되지 않습니다).
# service-key는 파일에 직접 값을 넣지 말고, DB_URL/DB_USERNAME/DB_PASSWORD와 동일하게
# IntelliJ Run Configuration의 Environment variables에 WEATHER_SERVICE_KEY를 추가하세요.
# 공공데이터포털(data.go.kr) 기상청_단기예보 조회서비스에서 발급받은 인증키를 그 값으로 넣으면 됩니다.
weather.service-key=${WEATHER_SERVICE_KEY}
weather.base-url=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0/getVilageFcst
# 위치 미동의/좌표 없음 시 사용할 기본 좌표 (서울시청)
weather.default-latitude=37.5665
weather.default-longitude=126.9780
# 외부 기상청 API 호출 타임아웃 (밀리초)
weather.connect-timeout-ms=5000
weather.read-timeout-ms=10000
