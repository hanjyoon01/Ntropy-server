<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- AiReportMapper 자바 인터페이스와 연결되는 XML 매퍼 설정 -->
<mapper namespace="com.ntropy.ai.mapper.AiReportMapper">

    <!-- DB 컬럼명과 Java AiReport 객체의 필드명을 1:1 매핑하는 ResultMap -->
    <resultMap id="aiReportResultMap" type="com.ntropy.ai.domain.AiReport">
        <id property="reportId" column="report_id"/>
        <result property="userId" column="user_id"/>
        <result property="yearMonth" column="year_month"/>
        <result property="financialSummaryJson" column="financial_summary_json"/>
        <result property="recommendationJson" column="recommendation_json"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- 공통으로 사용할 SELECT 컬럼 리스트 조각 -->
    <sql id="aiReportColumns">
        `report_id`, `user_id`, `year_month`,
    `financial_summary_json`, `recommendation_json`, `created_at`
    </sql>

    <!-- 1. AI 리포트 데이터 신규 저장 -->
    <insert id="insert" parameterType="com.ntropy.ai.domain.AiReport"
            useGeneratedKeys="true" keyProperty="reportId" keyColumn="report_id">
        INSERT INTO `AI_REPORT` (
            `user_id`, `year_month`,
            `financial_summary_json`, `recommendation_json`
        ) VALUES (
                     #{userId}, #{yearMonth},
                     #{financialSummaryJson}, #{recommendationJson}
                 )
    </insert>

    <!-- 사용자·연월 기준 AI 리포트 저장 또는 갱신 -->
    <insert id="upsert"
            parameterType="com.ntropy.ai.domain.AiReport">

        INSERT INTO `AI_REPORT` (
            `user_id`,
            `year_month`,
            `financial_summary_json`,
            `recommendation_json`
        ) VALUES (
                     #{userId},
                     #{yearMonth},
                     #{financialSummaryJson},
                     #{recommendationJson}
                 )
            ON DUPLICATE KEY UPDATE
                                 `financial_summary_json` = VALUES(`financial_summary_json`),
                                 `recommendation_json` = VALUES(`recommendation_json`)
    </insert>

    <!-- 2. PK(report_id) 기준 단건 조회 -->
    <select id="findById" resultMap="aiReportResultMap">
        SELECT <include refid="aiReportColumns"/>
        FROM `AI_REPORT`
        WHERE `report_id` = #{reportId}
    </select>

    <!-- 3. 특정 유저의 해당 연월 리포트 조회 -->
    <!-- UK_AI_REPORT_USER_YM 복합 유니크 인덱스를 사용합니다. -->
    <select id="findByUserIdAndYearMonth" resultMap="aiReportResultMap">
        SELECT <include refid="aiReportColumns"/>
        FROM `AI_REPORT`
        WHERE `user_id` = #{userId}
        AND `year_month` = #{yearMonth}
        LIMIT 1
    </select>

    <!-- 4. 특정 유저의 전체 리포트 히스토리 최신순 조회 -->
    <select id="findAllByUserId" resultMap="aiReportResultMap">
        SELECT <include refid="aiReportColumns"/>
        FROM `AI_REPORT`
        WHERE `user_id` = #{userId}
        ORDER BY `year_month` DESC
    </select>

</mapper>